{% extends 'base.html.twig' %}

{% block title %}Dashboard Employé{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/employe/dashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="employe-dashboard">

        <h1>Dashboard Employé</h1>
        <p class="employe-intro">
            Espace de gestion et de modération réservé aux employés.
        </p>

        <div class="dashboard-section">
            <h2>Avis et livres</h2>
            <div class="employe-actions">
                <a href="{{ url('employe_avis_signales') }}" class="btn-moderation">Modération des avis signalés</a>
                <a href="{{ path('employe_livres_signales') }}" class="btn-livres">Gestion des livres signalés</a>
                <a href="{{ path('app_recherche_livre') }}" class="btn-livres-site">Gestion des livres du site</a>
            </div>
        </div>

        <div class="dashboard-section">
            <h2>Utilisateurs et clubs</h2>
            <div class="employe-actions">
                <a href="#" class="btn-utilisateur">Utilisateurs problématiques</a>
                <a href="#" class="btn-club">Clubs problématiques</a>
            </div>
        </div>

        <div class="dashboard-section">
            <h2>Messagerie</h2>
            <div class="employe-actions">
                <a href="#" class="btn-message">Messagerie Employés / Admin</a>
            </div>
        </div>

    </div>
{% endblock %}
