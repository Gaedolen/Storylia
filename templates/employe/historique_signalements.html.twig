{% extends 'base.html.twig' %}

{% block title %}Historique des signalements utilisateurs{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('css/employe/historique_signalements.css') }}">
    {% endblock %}

{% block body %}
    <h1>Historique des signalements utilisateurs</h1>

    <form method="get" class="filter-form">
        <div>
            <label>Status :</label>
            <select name="status">
                <option value="">Tous</option>
                <option value="traite" {% if statusFilter == 'traite' %}selected{% endif %}>Traité</option>
                <option value="refuse" {% if statusFilter == 'refuse' %}selected{% endif %}>Refusé</option>
                <option value="admin" {% if statusFilter == 'admin' %}selected{% endif %}>Transmis</option>
            </select>
        </div>

        <div>
            <label>Utilisateur :</label>
            <input type="text" name="user" value="{{ searchUser }}" placeholder="Pseudo…">
        </div>

        <button type="submit" class="btn btn-primary">Filtrer</button>
    </form>

    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>Utilisateur signalé</th>
                <th>Signalé par</th>
                <th>Motif</th>
                <th>Message</th>
                <th>Status</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
        {% for report in reports %}
            <tr>
                <td>{{ report.id }}</td>
                <td>{{ report.reported.pseudo }}</td>
                <td>{{ report.author.pseudo }}</td>
                <td>{{ report.reason }}</td>
                <td>{{ report.message }}</td>
                <td>
                    {% if report.status == 'traite' %}
                        <span class="badge badge-green">Traité</span>
                    {% elseif report.status == 'refuse' %}
                        <span class="badge badge-red">Refusé</span>
                    {% elseif report.status == 'transmis_admin' %}
                        <span class="badge badge-orange">Transmis</span>
                    {% endif %}
                </td>
                <td>{{ report.date|date('d/m/Y H:i') }}</td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7" style="text-align:center; color: #777;">Aucun signalement.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
