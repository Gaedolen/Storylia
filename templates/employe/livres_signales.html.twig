{% extends 'base.html.twig' %}

{% block title %}Livres signalés{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/employe/livres_signales.css') }}">
{% endblock %}

{% block body %}
    <h1>
        Livres signalés
    </h1>

    <table class="table-reports">
        <thead>
            <tr>
                <th>ID Report</th>
                <th>Livre</th>
                <th>Auteur</th>
                <th>Motif</th>
                <th>Message</th>
                <th>Signalé par</th>
                <th>Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            {% for report in reports %}
                {% if report.reportedBook %}
                <tr data-report-id="{{ report.id }}">
                    <td>{{ report.id }}</td>
                    <td>{{ report.reportedBook.title }}</td>
                    <td>{{ report.reportedBook.author.name }}</td>
                    <td>{{ report.reason }}</td>
                    <td>{{ report.message|default('—') }}</td>
                    <td>{{ report.author.pseudo }}</td>
                    <td>{{ report.date|date('d/m/Y') }}</td>
                    <td>
                        <a href="{{ path('employe_livre_edit', {'id': report.reportedBook.id}) }}" 
                        class="btn-edit">
                            <span class="desktop-text">Modifier livre</span>
                            <span class="mobile-text">Modifier</span>
                        </a>

                        <button class="btn-validate" data-report-id="{{ report.id }}">
                            <span class="desktop-text">Valider / supprimer signalement</span>
                            <span class="mobile-text">Valider</span>
                        </button>
                    </td>
                </tr>
                {% endif %}
            {% else %}
                <tr><td colspan="8">Aucun livre signalé pour le moment.</td></tr>
            {% endfor %}
        </tbody>
    </table>

    {# Modal détails livre #}
    <div class="modal" id="book-detail-modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Détails du livre</h3>
            <div id="book-detail-content"></div>
        </div>
    </div>
    {% endblock %}

    {% block javascripts %}
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const openModal = (modal) => { modal.style.display = 'flex'; };
        const closeModal = (modal) => { modal.style.display = 'none'; };
        const setupCloseOutside = (modal) => {
            window.addEventListener('click', e => { if(e.target === modal) closeModal(modal); });
        };

        const detailModal = document.getElementById('book-detail-modal');
        const detailContent = document.getElementById('book-detail-content');
        setupCloseOutside(detailModal);
        detailModal.querySelector('.close')?.addEventListener('click', () => closeModal(detailModal));

        // Voir détails
        document.querySelectorAll('.btn-detail').forEach(btn => {
            btn.addEventListener('click', async () => {
                const reportId = btn.dataset.reportId;
                const resp = await fetch(`/employe/livres-signales/detail/${reportId}`);
                const html = await resp.text();
                detailContent.innerHTML = html;
                openModal(detailModal);
            });
        });

        // Valider modification
        document.querySelectorAll('.btn-validate').forEach(btn => {
            btn.addEventListener('click', async () => {
                const reportId = btn.dataset.reportId;
                if (!confirm('Valider la modification et clôturer le report ?')) return;

                const resp = await fetch(`/employe/livres-signales/valider/${reportId}`, {
                    method: 'POST',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                const result = await resp.json();
                if (result.success) {
                    alert('Report validé.');
                    btn.closest('tr').remove();
                } else {
                    alert(result.message || 'Erreur serveur.');
                }
            });
        });
    });
    </script>
{% endblock %}
