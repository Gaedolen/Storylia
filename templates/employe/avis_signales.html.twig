{% extends 'base.html.twig' %}

{% block title %}Avis signalés{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/employe/avis_signales.css') }}">
{% endblock %}

{% block body %}
    <div class="employe-dashboard">

        <h1>Avis signalés</h1>
        <p class="admin-intro">Liste des avis signalés par les utilisateurs.</p>

        {% if avis is empty %}
            <p>Aucun avis signalé</p>
        {% else %}
            <table class="avis-table">
                <thead>
                    <tr>
                        <th>Livre</th>
                        <th>Auteur</th>
                        <th>Note</th>
                        <th>Commentaire</th>
                        <th>Signalé par</th>
                        <th>Message du signalement</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for review in avis %}
                        {% set report = review.reports|first %}
                        <tr>
                            <td>{{ review.book.title|e }}</td>
                            <td>{{ review.utilisateur.pseudo|e }}</td>
                            <td>{{ review.rating }}/5</td>
                            <td>{{ review.comment|e }}</td>
                            <td>{% if report %}{{ report.author.pseudo|e }}{% else %}-{% endif %}</td>
                            <td>{% if report %}{{ report.message|e }}{% else %}-{% endif %}</td>
                            <td class="admin-actions">
                                <form method="POST" action="{{ path('employe_avis_valider', {'id': review.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('valider_avis_' ~ review.id) }}">
                                    <button type="submit" class="btn-valider" title="Supprime l'avis et envoie un mail d'avertissement">
                                        Supprimer l'avis
                                    </button>
                                </form>

                                {% if report %}
                                    <form method="POST" action="{{ path('employe_report_supprimer', {'id': report.id}) }}" style="display:inline;">
                                        <input type="hidden" name="_token" value="{{ csrf_token('supprimer_report_' ~ report.id) }}">
                                        <button type="submit" class="btn-supprimer" title="Supprime seulement le signalement, l'avis est valide">
                                            Supprimer le signalement
                                        </button>
                                    </form>
                                {% else %}
                                    <span class="btn-supprimer disabled" title="Aucun signalement">Supprimer le signalement</span>
                                {% endif %}

                                <a href="{{ path('employe_avis_detail', {'id': review.id}) }}" class="btn-utilisateur">Voir signalement</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

    </div>
{% endblock %}