{% extends 'base.html.twig' %}

{% block title %}{{ club.name }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/club/show.css') }}">
{% endblock %}

{% block body %}
    <section class="club-header">

        <div class="club-info">
            <div class="club-title-actions">
                <h1>{{ club.name }}</h1>

                <div class="club-actions">
                    <a href="{{ path('club_info', {'id': club.id}) }}" class="btn-info">Plus d'informations</a>

                    {% if app.user and app.user == club.creator %}
                        <a href="{{ path('club_edit', {'id': club.id}) }}" class="btn-edit">Modifier</a>
                        {# Ici tu pourrais mettre le bouton de suppression pour le créateur #}
                    {% endif %}

                    {% if app.user %}
                        {% set isParticipant = club.membres|filter(p => p.id == app.user.id)|length > 0 %}
                        {% set isCreator = club.creator.id == app.user.id %}

                        {# --- Bouton signalement --- #}
                        {% if isParticipant and not isCreator %}
                            {% if hasReportedClub %}
                                {% if hasReportedClub.status == 'en_cours' %}
                                    <button class="btn-warning"
                                            disabled
                                            style="opacity:0.6; cursor:not-allowed;">
                                        Signalement envoyé ✓
                                    </button>
                                {% else %}
                                    <a class="btn-warning"
                                    data-bs-toggle="modal"
                                    data-bs-target="#reportClubModal"
                                    id="openReportClubBtn">
                                        Signaler un problème
                                    </a>
                                {% endif %}
                            {% else %}
                                <a class="btn-warning"
                                data-bs-toggle="modal"
                                data-bs-target="#reportClubModal"
                                id="openReportClubBtn">
                                    Signaler un problème
                                </a>
                            {% endif %}
                        {% endif %}

                        {# --- Bouton quitter ou supprimer club --- #}
                        {% if app.user %}

                            {# --- Si c'est le créateur --- #}
                            {% if club.creator and club.creator.id == app.user.id %}

                                <form method="post" action="{{ path('club_delete', {'id': club.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete_club_' ~ club.id) }}">
                                    <button type="submit" class="btn-danger"
                                            onclick="return confirm('Voulez-vous vraiment supprimer ce club ?');">
                                        Supprimer le club
                                    </button>
                                </form>

                            {# --- Sinon si c'est un membre --- #}
                            {% elseif club.membres|filter(m => m.id == app.user.id)|length > 0 %}

                                <form method="post" action="{{ path('club_quitter', {'id': club.id}) }}" style="display:inline;">
                                    <input type="hidden" name="_token" value="{{ csrf_token('quit_club_' ~ club.id) }}">
                                    <button type="submit" class="btn-danger"
                                            onclick="return confirm('Voulez-vous vraiment quitter ce club ?');">
                                        Quitter le club
                                    </button>
                                </form>

                            {% endif %}

                        {% endif %}

                    {% endif %}

                    <!-- Modal de signalement du club -->
                    <div class="modal fade" id="reportClubModal" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                
                                <!-- En-tête -->
                                <div class="modal-header">
                                    <h5 class="modal-title">Signaler un problème sur {{ club.name }}</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                                </div>

                                <!-- Corps du modal -->
                                <div class="modal-body">
                                    <form id="reportClubForm" method="post" action="{{ path('report_club', { id: club.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('report_club') }}">
                                        <label for="reportReason">Motif :</label>
                                        <select id="reason" name="reason" required>
                                            <option value="" disabled selected>Choisir un motif</option>
                                            <option value="spam">Spam ou publicité</option>
                                            <option value="offensant">Contenu offensant</option>
                                            <option value="faux_club">Faux club</option>
                                            <option value="autre">Autre</option>
                                        </select>

                                        <label for="reportMessage">Message :</label>
                                        <textarea id="message" name="message" maxlength="500" oninput="updateCharCount(this)" required></textarea>
                                        <div class="char-count">
                                            <span id="charCount-report">0</span> / 500 caractères
                                        </div>

                                        <div class="modal-footer">
                                            <button type="submit" class="btn-warning">Envoyer le signalement</button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Script pour compteur de caractères -->
                    <script>
                    function updateCharCount(textarea) {
                        const max = textarea.getAttribute('maxlength');
                        const remaining = max - textarea.value.length;
                        document.getElementById('charCount-report').innerText = remaining + ' caractères restants';
                    }
                    </script>


                </div>
            </div>

            <p class="club-description">
                {{ club.description }}
            </p>
        </div>

        <!-- Bloc droit : Lecture du mois prochain -->
        <div class="club-book-of-month">
            <h2>Livre du mois - {{ nextMonthName }}</h2>

            {% if bookOfNextMonth %}
                <div class="book-card-nm">
                    <!-- Image avec lien -->
                    <a href="{{ path('app_livre_detail', {id: bookOfNextMonth.id}) }}">
                        <img src="{{ bookOfNextMonth.cover|replace({'http://':'https://'})|e('html_attr') }}" alt="{{ bookOfNextMonth.title }}">
                    </a>

                    <!-- Infos à côté -->
                    <div class="book-information">
                        <a href="{{ path('app_livre_detail', {id: bookOfNextMonth.id}) }}">
                            <p class="book-title">{{ bookOfNextMonth.title }}</p>
                        </a>
                        <p class="book-author">
                            {{ bookOfNextMonth.author is not null ? bookOfNextMonth.author.name : 'Auteur inconnu' }}
                        </p>
                    </div>
                </div>
            {% else %}
                <p>Aucun livre prévu pour ce mois.</p>
            {% endif %}

            <!-- Bouton voter -->
            {% if userCanVote %}
                <button id="vote-btn" class="vote-btn">
                    Voter pour le prochain livre
                </button>
            {% else %}
                <div class="tooltip-container">
                    <button class="vote-btn" disabled>
                        Voter pour le prochain livre
                    </button>
                    <span class="tooltip-text">
                        {% if not userHasProposed %}
                            Vous devez d'abord proposer un livre
                        {% elseif userHasVoted %}
                            Vous avez déjà voté ce mois
                        {% endif %}
                    </span>
                </div>
            {% endif %}
        </div>

    </section>

    <section class="reading-month-section">

        <!-- Bloc livre du mois -->
        <div class="book-presentation">
            <h2>Livre du mois de {{ currentMonthName }}</h2>

            {% if bookOfMonth %}
                <div class="book-details">
                    <a href="{{ path('app_livre_detail', {id: bookOfMonth.id}) }}"><img src="{{ bookOfMonth.cover|replace({'http://':'https://'})|e('html_attr') }}" alt="{{ bookOfMonth.title }}" class="book-cover"></a>

                    <div class="book-info">
                        <a href="{{ path('app_livre_detail', {id: bookOfMonth.id}) }}"><p class="book-title">{{ bookOfMonth.title }}</p></a>
                        <a href="#"><p class="book-author">{{ bookOfMonth.author.name }}</p></a>
                    </div>
                </div>

                <hr>

                <div class="book-summary">
                    <h3>Résumé :</h3>
                    <p>{{ bookOfMonth.summary }}</p>
                </div>
            {% else %}
                <p>Aucun livre prévu pour ce mois.</p>
            {% endif %}
        </div>

        <!-- Bloc avis -->
        <div class="club-reviews-wrapper">
            <div class="club-reviews">
                <div class="reviews-header">
                    <h3>Avis laissés par les membres :</h3>
                    <a href="{{ path('club_all_reviews', {'id': club.id}) }}" class="btn-view-all">
                        Voir tous les avis
                    </a>
                </div>

                <div class="reviews-list">
                    {% for review in lastReviews %}
                        <div class="review-bubble">
                            <p class="review-meta">
                                <strong>{{ review.user.pseudo }}</strong> ({{ review.createdAt|date('d/m/Y') }})
                            </p>
                            <p class="review-comment">{{ review.comment }}</p>
                        </div>
                    {% else %}
                        <p>Aucun avis pour le moment.</p>
                    {% endfor %}
                </div>
                <div class="review-footer">
                    <button class="btn-leave-review"
                            data-bs-toggle="modal"
                            data-bs-target="#reviewModal"
                            {% if userHasReviewedMonth %} disabled {% endif %}>
                        Laisser un avis
                    </button>
                </div>
            </div>
        </div>

    </section>

    <section class="recent-books-carousel">
        <div class="recent-books-header">
            <h2>Dernières propositions de lecture</h2>
            <a href="{{ path('club_propositions', {'id': club.id}) }}" class="btn btn-primary btn-sm">Voir toutes les propositions</a>
        </div>

        {% if recentBookProposals is empty %}
            <p>Aucun livre proposé pour le moment.</p>
        {% else %}
            <div class="carousel-container">
                <div class="recent-books-container">
                    {% for proposal in recentBookProposals|slice(0, 20) %}
                        <a href="{{ path('app_livre_detail', {id: proposal.book.id}) }}" class="book-card">
                            <div class="card">
                                <img src="{{ proposal.book.cover|replace({'http://':'https://'})|e('html_attr') }}" class="card-img-top" alt="{{ proposal.book.title }}">
                                <div class="card-body text-center">
                                    <h6 class="card-title">
                                        {{ proposal.book.title|length > 25 ? proposal.book.title[:25] ~ '…' : proposal.book.title }}
                                    </h6>
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
    </section>

    {# Modal de vote #}
    {% if clubReadingMonth is not null %}
        <div id="voteModal" class="vote-modal" style="display:none;">
            <div class="modal-content">
                <span class="close-modal">×</span>
                <h2>Votez pour le livre du mois de {{ nextNextMonthName }}</h2>

                <form action="{{ path('club_vote', { clubId: club.id }) }}" method="post">
                    <input type="hidden" name="_token" value="{{ csrf_token('vote_' ~ club.id) }}">


                    <div class="books-grid">
                        {% for proposal in clubReadingMonth.bookProposals %}
                            {% set book = proposal.book %}
                            <div class="book-card">
                                <div class="book-cover-wrapper">
                                    <label for="proposal-{{ proposal.id }}">
                                        <img src="{{ book.cover|replace({'http://':'https://'})|e('html_attr') }}" alt="{{ book.title }}" class="book-cover">
                                    </label>

                                        <input 
                                            type="radio" 
                                            id="proposal-{{ proposal.id }}" 
                                            name="vote[bookProposal]"
                                            value="{{ proposal.id }}"
                                        >
                                    {% if proposal.id in leadingProposals %}
                                        <div class="crown">👑</div>
                                    {% endif %}
                                </div>

                                <div class="book-info">
                                    <div class="book-title">{{ book.title }}</div>
                                    <div class="book-author">{{ book.author.name }}</div>
                                    <div class="book-proposer">Proposé par {{ proposal.proposer.pseudo }}</div>
                                    <div class="vote-count">{{ proposal.votes|length }} vote{{ proposal.votes|length > 1 ? 's' : '' }}</div>
                                </div>
                            </div>
                        {% else %}
                            <p>Aucun livre proposé pour le moment.</p>
                        {% endfor %}
                    </div>

                    <div class="vote-btn-container">
                        <button type="submit" class="btn btn-primary">Voter</button>
                    </div>
                </form>
            </div>
        </div>
    {% endif %}

    <!-- Modal laisser un avis -->
    <div class="modal fade" id="reviewModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Laisser un avis</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    {% if bookOfMonthReading %}
                        <form 
                            id="reviewForm"
                            method="post"
                            data-month="{{ bookOfMonthReading.id }}"
                            data-url="{{ path('club_review_add') }}"
                        >
                            <input type="hidden" name="_token" value="{{ csrf_token('review') }}">

                            <label for="comment" class="form-label">
                                Votre avis (max 1000 caractères)
                            </label>

                            <textarea 
                                id="comment" 
                                name="comment" 
                                class="form-control" 
                                maxlength="1000" 
                                rows="6" 
                                required
                            ></textarea>

                            <div class="text-end mt-1">
                                <small>
                                    <span id="charCount">0</span>/1000 caractères
                                </small>
                            </div>

                            <button type="submit" class="btn btn-primary mt-3">
                                Valider
                            </button>
                        </form>
                    {% else %}
                        <p class="text-muted">Aucun livre du mois à commenter pour le moment.</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <script src="{{ asset('js/club.js') }}"></script>

{% endblock %}
