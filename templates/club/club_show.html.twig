{% extends 'base.html.twig' %}

{% block title %}Liste des clubs{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/club/show.css') }}">
{% endblock %}

{% block body %}
    <section class="club-header">

        <div class="club-info">
            <div class="club-title-actions">
                <h1>{{ club.name }}</h1>

                <div class="club-actions">
                    <a href="{{ path('club_info', {'id': club.id}) }}" class="btn-info">Plus d'informations</a>

                    {% if app.user and app.user == club.creator %}
                        <a href="{{ path('club_edit', {'id': club.id}) }}" class="btn-edit">Modifier</a>
                    {% endif %}
                </div>
            </div>

            <p class="club-description">
                {{ club.description }}
            </p>
        </div>

        <!-- Bloc droit : Lecture du mois prochain -->
        <div class="club-book-of-month">
            <h2>Livre du mois - {{ nextMonthName }}</h2>

            {% if bookOfNextMonth %}
                    <div class="book-card">
                        <a href="{{ path('app_livre_detail', {id: bookOfNextMonth.id}) }}"><img src={{ bookOfNextMonth.cover }} alt="{{ bookOfNextMonth.title }}"><a>
                        <div class="book-info">
                            <a href="{{ path('app_livre_detail', {id: bookOfNextMonth.id}) }}"><p class="book-title">{{ bookOfNextMonth.title }}</p></a>
                            <a href="#"><p class="book-author">{{ bookOfNextMonth.author.name }}</p></a>
                        </div>
                    </div>
                </a>
            {% else %}
                <p>Aucun livre prévu pour ce mois.</p>
            {% endif %}

            <a href="#{#{{ path('club_vote_next_book', {'id': club.id}) }}#}" class="btn-vote">Voter pour le prochain livre</a>
        </div>

    </section>

    <section class="reading-month-section">

        <!-- Bloc livre du mois -->
        <div class="book-presentation">
            <h2>Livre du mois de {{ currentMonthName }}</h2>

            {% if bookOfMonth %}
                <div class="book-details">
                    <a href="{{ path('app_livre_detail', {id: bookOfMonth.id}) }}"><img src={{ bookOfMonth.cover }} alt="{{ bookOfMonth.title }}" class="book-cover"></a>

                    <div class="book-info">
                        <a href="{{ path('app_livre_detail', {id: bookOfMonth.id}) }}"><p class="book-title">{{ bookOfMonth.title }}</p></a>
                        <a href="#"><p class="book-author">{{ bookOfMonth.author.name }}</p></a>
                    </div>
                </div>

                <hr>

                <div class="book-summary">
                    <h3>Résumé :</h3>
                    <p>{{ bookOfMonth.summary }}</p>
                </div>
            {% else %}
                <p>Aucun livre prévu pour ce mois.</p>
            {% endif %}
        </div>

        <!-- Bloc avis -->
        <div class="club-reviews">
            <div class="reviews-header">
                <h3>Avis laissés par les membres :</h3>
                <a href="#{#{{ path('club_all_reviews', {'id': club.id}) }}#}" class="btn-view-all">Voir tous les avis</a>
            </div>

            <div class="reviews-list">
                {% for review in lastReviews %}
                    <div class="review-bubble">
                        <p class="review-meta"><strong>{{ review.user.pseudo }}</strong> ({{ review.createdAt|date('d/m/Y') }})</p>
                        <p class="review-comment">{{ review.comment }}</p>
                    </div>
                {% endfor %}
            </div>
            <div class="review-footer">
                <a href="#{#{{ path('club_leave_review', {'id': club.id}) }}#}" class="btn-leave-review">Laisser mon avis</a>
            </div>
        </div>

    </section>

    <section class="recent-books-carousel">
        <div class="recent-books-header">
            <h2>Dernières propositions de lecture</h2>
            <a href="#" class="btn btn-primary btn-sm">Voir toutes les propositions</a>
        </div>

        {% if recentBooks is empty %}
            <p>Aucun livre proposé pour le moment.</p>
        {% else %}
            <div class="carousel-container">
                <div id="recentBooksCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                    <div class="carousel-inner">
                        {% for chunk in recentBooks|batch(5) %}
                            <div class="carousel-item {% if loop.first %}active{% endif %}">
                                <div class="d-flex justify-content-center gap-3">
                                    {% for book in chunk %}
                                        <a href="{{ path('app_livre_detail', {id: book.id}) }}" class="carousel-card-link">
                                            <div class="card carousel-card">
                                                <img src="{{ book.cover }}" class="card-img-top" alt="{{ book.title }}">
                                                <div class="card-body text-center">
                                                    <h6 class="card-title">{{ book.title|length > 25 ? book.title[:25] ~ '…' : book.title }}</h6>
                                                </div>
                                            </div>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Flèches -->
                <button class="carousel-control-prev" type="button" data-bs-target="#recentBooksCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Précédent</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#recentBooksCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                    <span class="visually-hidden">Suivant</span>
                </button>
            </div>
        {% endif %}
    </section>

{% endblock %}
