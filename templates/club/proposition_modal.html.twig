<div id="proposerLivreModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Proposer un livre pour {{ month|format_datetime(pattern="MMMM yyyy", locale="fr") }}</h2>
        <input type="text" id="searchBook" placeholder="Rechercher un livre..." />
        <div id="booksGrid" class="books-grid">
            {% for book in books %}
                <div class="book-card" data-title="{{ book.title|lower }}">
                    <div class="checkbox-container">
                        <input type="radio" name="selectedBook" value="{{ book.id }}">
                    </div>
                    <img src="{{ book.cover|replace({'http://':'https://'})|e('html_attr') }}" alt="{{ book.title }}">
                    <p class="book-title">{{ book.title }}</p>
                    <p class="book-author">{{ book.author.name }}</p>
                </div>
            {% endfor %}
        </div>
        <button 
            id="validerBook"
            data-action="{{ path('club_proposer_livre', {'clubId': club.id, 'month': month}) }}"
            data-token="{{ csrf_token('propose_book_' ~ club.id ~ '_' ~ month|date('Y-m')) }}"
            class='btn btn-primary'
            disabled
        >
            Valider
        </button>
    </div>
</div>
