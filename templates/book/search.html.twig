{% extends 'base.html.twig' %}

{% block title %}Résutat de recherche{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/book/search.css') }}">
{% endblock %}

{% block body %}
    <div class="recherche-container">

        <!-- Colonne gauche : filtres -->
        <aside class="filtres">
            <h3><strong>Filtres</strong></h3>
            <form method="get" action="{{ path('app_recherche_livre') }}">
                <input type="hidden" name="q" value="{{ app.request.get('q') }}">
                
                {# <label>Catégorie :</label>
                <select name="category">
                    <option value="">Toutes</option>

                    {% set categories = {
                        'Fiction': {
                            'Science-Fiction': 'scifi',
                            'Fantastique': 'fantastique',
                            'Fantasy': 'fantasy',
                            'Dystopie': 'dystopie',
                            'Steampunk': 'steampunk'
                        },
                        'Policier / Suspense': {
                            'Policier': 'policier',
                            'Thriller': 'thriller',
                            'Espionnage': 'espionnage',
                            'Horreur': 'horreur'
                        },
                        'Romance & Jeunesse': {
                            'Aventure': 'aventure',
                            'Young Adult': 'young_adult'
                        },
                        'Romance et roman adulte': {
                            'Romance': 'romance',
                            'Érotique': 'erotique',
                            'Chick-lit': 'chicklit'
                        },
                        'Culture, Histoire & Documentaire': {
                            'Essai': 'essai',
                            'Biographie': 'biographie',
                            'Philosophie': 'philosophie',
                            'Historique': 'historique',
                            'Science': 'science',
                            'Sociologie': 'sociologie'
                        },
                        'Arts & Littérature': {
                            'Poésie': 'poesie',
                            'Théâtre': 'theatre'
                        },
                        'Mythes et Légendes': {
                            'Contes et légendes': 'conte_legend',
                            'Mythologie': 'mythologie'
                        },
                        'Graphique': {
                            'Roman Graphique': 'graphic_novel',
                            'Bande dessinée': 'bd',
                            'Manga': 'manga'
                        }
                    } %} #}

                    {# {% for main, subcats in categories %}
                        <optgroup label="{{ main }}">
                            {% for label, value in subcats %}
                                <option value="{{ value }}"
                                    {% if app.request.get('category') == value %}selected{% endif %}>
                                    {{ label }}
                                </option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select> #}

                <label>Date de parution :</label>
                <select name="date">
                    <option value="">Toutes</option>
                    <option value="recent">Les plus récents</option>
                    <option value="ancien">Les plus anciens</option>
                </select>

                <label>Note minimale :</label>
                <select name="note_min">
                    <option value="">Aucune</option>
                    <option value="1">1 ★</option>
                    <option value="2">2 ★</option>
                    <option value="3">3 ★</option>
                    <option value="4">4 ★</option>
                    <option value="5">5 ★</option>
                </select>

                <button type="submit" class="btn-filtrer">Appliquer</button>
            </form>

            <!-- Bouton ouverture modal -->
            <button id="open-search-book-modal" type="button" class="btn-ajouter-livre">
                Vous ne trouvez pas votre livre ?
            </button>
        </aside>

        {# Modal de recherche de livre #}
        <div id="search-book-modal" class="modal hidden">
            <div class="modal-content">
                <span class="close">&times;</span>
                <h2>Trouver un livre</h2>

                <form id="bookSearchForm">
                    <div class="form-group">
                        <label for="search-title">Titre :</label>
                        <input type="text" id="searchTitle" placeholder="Ex: Harry Potter">
                    </div>

                    <div class="form-group">
                        <label for="search-author">Auteur :</label>
                        <input type="text" id="searchAuthor" placeholder="Ex: J.K. Rowling">
                    </div>

                    <div id="searchResults"></div>

                    <button id="book-not-found-btn" type="button" class="hidden">
                        Livre introuvable ?
                    </button>
                </form>

                {# Formulaire de création d'un livre #}
                <div id="bookCreationForm" class='hidden' style=" margin-top:20px;">
                    <h3>Ajouter un livre</h3>
                    <form id="formBookCreation">

                        <div class="form-group">
                            <label for="bookTitle">Titre</label>
                            <input type="text" id="bookTitle" name="title" required>
                        </div>

                        <div class="form-group">
                            <label for="bookAuthor">Auteur</label>
                            <input type="text" id="bookAuthor" name="author" required>
                        </div>

                        <p class="warning-message">
                            Avant de valider l'ajout de ce livre, merci de bien vérifier l'orthographe du titre et de l'auteur.<br>
                        </p>

                        <button type="submit" id="createBookBtn">Créer</button>

                    </form>
                </div>
            </div>
        </div>

        <!-- Colonne centrale : résultats -->
        <main class="resultats">

            {# Formulaire de recherche #}
            <form class="search-bar" action="{{ path('app_recherche_livre') }}" method="get">
                <input type="text" name="q" placeholder="Rechercher un livre, un auteur..." required>
                <button type="submit">
                <i class="bi bi-search"></i>
                </button>
            </form>

            <h2>Résultats pour “{{ app.request.get('q') }}”</h2>

            {% if livres is empty %}
                <p>Aucun livre trouvé.</p>
            {% else %}
                <div class="livres-list">
                    {% for livre in livres %}
                        <a href="{{ path('app_livre_detail', {id: livre.id}) }}" class="livre-card">
                            <div class="cover">
                                <img src="{{ livre.cover }}" alt="{{ livre.title }}">
                            </div>
                            <div class="info">
                                <h4 class="title">{{ livre.title }}</h4>
                                {% if livre.voTitle %}
                                    <h5 class="vo-title">{{ livre.voTitle }}</h5>
                                {% endif %}
                                <div class="note">
                                    {% set rating = livre.averageRating ?? 0 %}
                                    {% for i in 1..5 %}
                                        {% if i <= rating %}
                                            <span class="star full">★</span>
                                        {% else %}
                                            <span class="star empty">☆</span>
                                        {% endif %}
                                    {% endfor %}
                                    <span class="score">{{ livre.averageRating ? livre.averageRating ~ '/5' : 'N/A' }}</span>
                                </div>
                                <p class="author">Par {{ livre.author.name }}</p>
                                <div class="meta">
                                    {% if livre.publishers is not empty %}
                                        <span class="publisher">{{ livre.publishers[0] }}</span>
                                    {% endif %}
                                    {% if livre.publicationDate %}
                                        <span class="date">{{ livre.publicationDate|date('d/m/Y') }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </a>
                    {% endfor %}
                </div>

                {# Pagination (20 résultats par page) #}
                <div class="pagination">
                    {% if page > 1 %}
                        <a href="{{ path('app_recherche_livre', { q: app.request.get('q'), page: page - 1 }) }}">&laquo; Précédent</a>
                    {% endif %}
                    <span>Page {{ page }}</span>
                    {% if livres|length == 20 %}
                        <a href="{{ path('app_recherche_livre', { q: app.request.get('q'), page: page + 1 }) }}">Suivant &raquo;</a>
                    {% endif %}
                </div>
            {% endif %}
        </main>

        <!-- Colonne droite : auteurs -->
        <aside class="auteurs">
            <h3>Auteurs populaires</h3>

            {% if auteurs is empty %}
                <p>Aucun auteur correspondant.</p>
            {% else %}
                <div class="auteurs-list">
                    {% for auteur in auteurs %}
                        <a href='#' {#"{{ path('app_auteur_detail', { id: auteur.id }) }}"#} class="auteur-card">
                            <div class="auteur-info">
                                <h4>{{ auteur.name }}</h4>
                                <p class="livres-count">{{ auteur.books|length }} livre{% if auteur.books|length > 1 %}s{% endif %}</p>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            <h3 style="margin-top: 25px;">Utilisateurs</h3>

            {% if utilisateurs is empty %}
                <p>Aucun utilisateur correspondant.</p>
            {% else %}
                <div class="auteurs-list">
                    {% for user in utilisateurs %}
                        <a href="{{ path('app_utilisateur_profil', { id: user.id }) }}" class="auteur-card user-card">
                            <img src="{{ asset('uploads/profiles/' ~ user.profilePicture) }}" alt="Photo de profil" class='utilisateur-avatar'>
                            <div class="auteur-info">
                                <h4>{{ user.pseudo }}</h4>
                            </div>
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </aside>

    </div>

    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('js/addBookModal.js') }}"></script>
    {% endblock %}
{% endblock %}