{% extends 'base.html.twig' %}

{% block title %}Résutat de recherche{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/book/search.css') }}">
{% endblock %}

{% block body %}
    <div class="recherche-container">

        <!-- Colonne gauche : filtres -->
        <aside class="filtres">
            <h3><strong>Filtres</strong></h3>
            <form method="get" action="{{ path('app_recherche_livre') }}">
                <input type="hidden" name="q" value="{{ app.request.get('q') }}">
                
                <label>Catégorie :</label>
                <select name="category">
                    <option value="">Toutes</option>

                    {% set categories = {
                        'Fiction': {
                            'Science-Fiction': 'scifi',
                            'Fantastique': 'fantastique',
                            'Fantasy': 'fantasy',
                            'Dystopie': 'dystopie',
                            'Steampunk': 'steampunk'
                        },
                        'Policier / Suspense': {
                            'Policier': 'policier',
                            'Thriller': 'thriller',
                            'Espionnage': 'espionnage',
                            'Horreur': 'horreur'
                        },
                        'Romance & Jeunesse': {
                            'Aventure': 'aventure',
                            'Young Adult': 'young_adult'
                        },
                        'Romance et roman adulte': {
                            'Romance': 'romance',
                            'Érotique': 'erotique',
                            'Chick-lit': 'chicklit'
                        },
                        'Culture, Histoire & Documentaire': {
                            'Essai': 'essai',
                            'Biographie': 'biographie',
                            'Philosophie': 'philosophie',
                            'Historique': 'historique',
                            'Science': 'science',
                            'Sociologie': 'sociologie'
                        },
                        'Arts & Littérature': {
                            'Poésie': 'poesie',
                            'Théâtre': 'theatre'
                        },
                        'Mythes et Légendes': {
                            'Contes et légendes': 'conte_legend',
                            'Mythologie': 'mythologie'
                        },
                        'Graphique': {
                            'Roman Graphique': 'graphic_novel',
                            'Bande dessinée': 'bd',
                            'Manga': 'manga'
                        }
                    } %}

                    {% for main, subcats in categories %}
                        <optgroup label="{{ main }}">
                            {% for label, value in subcats %}
                                <option value="{{ value }}"
                                    {% if app.request.get('category') == value %}selected{% endif %}>
                                    {{ label }}
                                </option>
                            {% endfor %}
                        </optgroup>
                    {% endfor %}
                </select>

                <label>Date de parution :</label>
                <select name="date">
                    <option value="">Toutes</option>
                    <option value="recent">Les plus récents</option>
                    <option value="ancien">Les plus anciens</option>
                </select>

                <label>Note minimale :</label>
                <select name="note_min">
                    <option value="">Aucune</option>
                    <option value="1">1 ★</option>
                    <option value="2">2 ★</option>
                    <option value="3">3 ★</option>
                    <option value="4">4 ★</option>
                    <option value="5">5 ★</option>
                </select>

                <button type="submit" class="btn-filtrer">Appliquer</button>
            </form>

            <!-- Bouton ouverture modal -->
            <button id="open-search-book-modal" type="button" class="btn-ajouter-livre">
                Vous ne trouvez pas votre livre ?
            </button>
        </aside>

        {# Modal de recherche de livre #}
        <div id="search-book-modal" class="modal hidden">
            <div class="modal-content">
                <span class="close">&times;</span>
                <h2>Trouver un livre</h2>

                <div class="form-group">
                    <label for="search-title">Titre :</label>
                    <input type="text" id="searchTitle" placeholder="Ex: Harry Potter">
                </div>

                <div class="form-group">
                    <label for="search-author">Auteur :</label>
                    <input type="text" id="searchAuthor" placeholder="Ex: J.K. Rowling">
                </div>

                <div id="searchResults"></div>

                <button id="book-not-found-btn" type="button" style="display:none;">
                    Livre introuvable ?
                </button>

                {# Formulaire de création d'un livre #}
                <div id="creationBookForm" class="hidden">
                    <h2>Créer un nouveau livre</h2>
                    <form id="formBookCreation">
                        <div class="form-group">
                            <label for="title">Titre</label>
                            <input type="text" name="title" id="title" required>
                        </div>

                        <div class="form-group">
                            <label for="author">Auteur</label>
                            <input type="text" name="author" id="author" required>
                        </div>

                        <div class="form-group">
                            <label for="genre">Genre littéraire</label>
                            <select name="genre" id="genre" required>
                                <option value="">Choisir un genre</option>
                                {% set categories = {
                                    'Fiction': {
                                    'Science-Fiction': 'scifi',
                                    'Fantastique': 'fantastique',
                                    'Fantasy': 'fantasy',
                                    'Dystopie': 'dystopie',
                                    'Steampunk': 'steampunk'
                                },
                                'Policier / Suspense': {
                                    'Policier': 'policier',
                                    'Thriller': 'thriller',
                                    'Espionnage': 'espionnage',
                                    'Horreur': 'horreur'
                                },
                                'Romance & Jeunesse': {
                                    'Aventure': 'aventure',
                                    'Young Adult': 'young_adult'
                                },
                                'Romance et roman adulte': {
                                    'Romance': 'romance',
                                    'Érotique': 'erotique',
                                    'Chick-lit': 'chicklit'
                                },
                                'Culture, Histoire & Documentaire': {
                                    'Essai': 'essai',
                                    'Biographie': 'biographie',
                                    'Philosophie': 'philosophie',
                                    'Historique': 'historique',
                                    'Science': 'science',
                                    'Sociologie': 'sociologie'
                                },
                                'Arts & Littérature': {
                                    'Poésie': 'poesie',
                                    'Théâtre': 'theatre'
                                },
                                'Mythes et Légendes': {
                                    'Contes et légendes': 'conte_legend',
                                    'Mythologie': 'mythologie'
                                },
                                'Graphique': {
                                    'Roman Graphique': 'graphic_novel',
                                    'Bande dessinée': 'bd',
                                    'Manga': 'manga'
                                }
                                } %}

                                {% for group, genres in categories %}
                                    <optgroup label="{{ group }}">
                                        {% for label, value in genres %}
                                           <option value="{{ value }}">{{label}}</option>
                                        {% endfor %}
                                    </optgroup>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="form-group">
                            <label for="parutionDate">Date de parution</label>
                            <input type="date" name="parutionDate" id="parutionDate" required>
                        </div>

                        <button type="submit" class="btn-principal">Créer le livre</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Colonne centrale : résultats -->
        <main class="resultats">
            <h2>Résultats pour “{{ app.request.get('q') }}”</h2>

            {% if livres is empty %}
                <p>Aucun livre trouvé.</p>
            {% else %}
                <div class="livres-grid">
                    {% for livre in livres %}
                        <div class="livre-card">
                            <img src="{{ asset('uploads/livres/' ~ livre.coverImage) }}" alt="{{ livre.title }}">
                            <div class="livre-info">
                                <h4>{{ livre.title }}</h4>
                                <p class="auteur">{{ livre.author }}</p>
                                <p class="note">Note : {{ livre.rating ?? 'N/A' }} ★</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Pagination (20 résultats par page) #}
                <div class="pagination">
                    {% if page > 1 %}
                        <a href="{{ path('app_recherche_livre', { q: app.request.get('q'), page: page - 1 }) }}">&laquo; Précédent</a>
                    {% endif %}
                    <span>Page {{ page }}</span>
                    {% if livres|length == 20 %}
                        <a href="{{ path('app_recherche_livre', { q: app.request.get('q'), page: page + 1 }) }}">Suivant &raquo;</a>
                    {% endif %}
                </div>
            {% endif %}
        </main>

        <!-- Colonne droite : auteurs -->
        <aside class="auteurs">
            <h3>Auteurs populaires</h3>
            {% if auteurs is empty %}
                <p>Aucun auteur correspondant.</p>
            {% else %}
                <ul>
                    {% for auteur in auteurs %}
                        <li>{{ auteur.name }}</li>
                    {% endfor %}
                </ul>
            {% endif %}
        </aside>
    </div>

    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('js/addBookModal.js') }}"></script>
    {% endblock %}
{% endblock %}