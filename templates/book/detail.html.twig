{% extends 'base.html.twig' %}

{% block title %}{{ book.title }}{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/book/detail.css') }}">
{% endblock %}

{% block body %}
    <div class="book-top-block">
        <!-- Boutons principaux à gauche -->
        <div class="book-actions-left">
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_EMPLOYE') %}
                <button class="btn-main">Modifier</button>
                <button class="btn-main">Supprimer</button>
            {% endif %}

            {# Bouton Ajouter / Déplacer #}
            <button 
                class="btn-main"
                data-add-to-bookshelf
                data-book-id="{{ book.id }}"
                data-bookshelf-id="{{ bookshelfEntry ? bookshelfEntry.id : '' }}"
                data-current-status-label="{{ bookshelfEntry ? prettyStatuses[bookshelfEntry.readingStatus.label]|default(bookshelfEntry.readingStatus.label) : 'Aucun' }}">
                {{ bookshelfEntry ? 'Déplacer' : 'Ajouter' }}
            </button>

            {# Modal bookshelf #}
            <div id="bookshelf-modal" class="modal" style="display:none;">
                <div class="modal-content">
                    <span class="close">&times;</span>

                    {% set prettyStatuses = {
                        'en_train_de_lire': 'En train de lire',
                        'coup_de_coeur': 'Coup de coeur',
                        'adore': 'J\'adore',
                        'apprecie': 'Apprécié',
                        'mitige': 'Mitigé',
                        'pas_aime': 'Pas aimé',
                        'lu_aussi': 'Lu',
                        'pal': 'Pile à lire',
                        'envies': 'Mes envies',
                    } %}

                    <h3>{{ bookshelfEntry ? 'Déplacer dans ta bibliothèque' : 'Ajouter à ta bibliothèque' }}</h3>

                    {% if bookshelfEntry %}
                        <p>Statut actuel : 
                            <span class="bookshelf-current-status">
                                {% if bookshelfEntry %}
                                    {{ prettyStatuses[bookshelfEntry.readingStatus.label]|default(bookshelfEntry.readingStatus.label) }}
                                {% else %}
                                    Aucun
                                {% endif %}
                            </span>
                        </p>
                    {% endif %}

                    <label for="bookshelf-status-select">Choisir un nouveau statut :</label>

                    <select name="readingStatus" id="bookshelf-status-select">
                        <option value="" disabled {% if not bookshelfEntry %}selected{% endif %}>Choisis un statut</option>
                        {% for status in readingStatuses %}
                            <option value="{{ status.id }}" 
                                {% if bookshelfEntry and status.id == bookshelfEntry.readingStatus.id %}selected{% endif %}>
                                {{ prettyStatuses[status.label]|default(status.label) }}
                            </option>
                        {% endfor %}
                    </select>

                    <button id="bookshelf-save-btn" class="btn-main">
                        {{ bookshelfEntry ? 'Déplacer' : 'Ajouter' }}
                    </button>
                </div>
            </div>

            {# Bouton avis / modification #}
            {% if isInLibrary %}
                {% if avisExiste %}
                    <button class="btn-main" disabled>Avis laissé ✓</button>
                {% else %}
                    <button class="btn-main" 
                            data-modal="leave-review-modal"
                            data-book-id="{{ book.id }}">
                        Laisser un avis
                    </button>
                {% endif %}

                {# Bouton Date de lecture / modification #}
                {% if dateLectureExiste %}
                    <button class="btn-main" disabled>Date laissée ✓</button>
                {% else %}
                    <button class="btn-main" id="add-reading-date-btn">Date de lecture</button>
                {% endif %}

                {# Bouton Note / Modification #}
                {% if reviewNote is not null %}
                    <button class="btn-main" id="leave-rating-btn" disabled>Note laissée ✓</button>
                {% else %}
                    <button class="btn-main" id="leave-rating-btn"  data-rate-url="{{ path('app_review_submit', {'id': book.id}) }}">Laisser une note</button>
                {% endif %}
            {% endif %}
        </div>

        <!-- Couverture + Infos Livre -->
        <div class="livre-container">

            <div class="livre-infos">
                <img src={{ book.cover }} alt="{{ book.title }}">

                <div class="livre-details">
                    <h2>{{ book.title }}</h2>
                    {% if book.voTitle %}
                        <p><strong>Titre VO : </strong> {{ book.voTitle }}</p>
                    {% endif %}
                    <p><strong>Auteur : </strong> {{ book.author.name }}</p>
                    <p><strong>Edition(s) : </strong>
                        {% for publisher in book.publishers %}
                            {{ publisher }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </p>
                    <p><strong>Pages : </strong> {{ book.pages }}</p>
                    <p><strong>Date de sortie : </strong> {{ book.publicationDate|date('Y-m-d') }}</p>
                    <p><strong>Genre(s) : </strong>
                        {% for genre in book.genres %}
                            {{ genre }}{% if not loop.last %}, {% endif %}
                        {% endfor %}
                    </p>
                    <p><strong>Thème(s) : </strong></p>
                    <div class="tags" id="subject-list">
                        {% for subject in book.subjects %}
                            <span class="subject-item">{{ subject }}</span>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <!-- Résumé sous le bloc infos -->
            <div class="livre-resume">
                <h3>Résumé :</h3>
                <p>{{ book.summary }}</p>
            </div>

        </div>

        <!-- Boutons additionnels à droite -->
        <div class="book-actions-right">

            {# Bouton modification couverture #}
            {% if app.user %}
                <button class="btn-main" data-modal="edit-cover-modal">Modifier la couverture</button>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-main">Modifier la couverture</a>
            {% endif %}

            {# Modal modification couverture #}
            <div class="modal" id="edit-cover-modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h3>Modifier la couverture</h3>

                    <form action="{{ path('app_livre_edit_cover', {'id': book.id}) }}" method="POST" enctype="multipart/form-data">
                        <label class="btn-main" for="cover-input">Sélectionner une nouvelle couverture</label>
                        <input type="file" name="cover" id="cover-input" accept="image/*" style="display:none;">
                        <p class="file-name" style="margin-top:8px;color:#4b2e05;"></p>

                        <button type="submit" class="btn-main" style="margin-top:15px;">Valider</button>
                    </form>
                </div>
            </div>

            {# Bouton ajout de thèmes #}
            {% if book.subjects|length < 10 %}
                {% if app.user %}
                    {% if book.subjects|length < 10 %}
                        <button class="btn-main" data-modal="add-subject-modal">Ajouter des thèmes</button>
                    {% endif %}
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn-main">Ajouter des thèmes</a>
                {% endif %}
            {% endif %}

            {# Modal ajout de thèmes #}
            <div class="modal" id="add-subject-modal" data-available="{{ availableSlots }}">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h3>Ajouter un ou plusieurs thèmes</h3>

                    {% if availableSlots > 0 %}
                        <form id="edit-subjects-form" action="{{ path('app_livre_edit_subjects', {'id': book.id}) }}" method="POST">
                            <div id="subjects-container">
                                <div class="subject-field">
                                    <input type="text" name="subjects[]" placeholder="Nouveau thème" class="subject-input">
                                </div>
                            </div>
                            <button type="button" id="add-subject-btn" class="btn-secondary">+ Ajouter un champ</button>
                            <button type="submit" class="btn-main">Valider</button>
                        </form>
                    {% else %}
                        <p>Le livre a déjà le nombre maximum de thèmes.</p>
                    {% endif %}
                </div>
            </div>

            {# Bouton modification résumé #}
            {% if app.user %}
                <button class="btn-main" data-modal="edit-summary-modal">Modifier le résumé</button>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-main">Modifier le résumé</a>
            {% endif %}

            {# Modal modification résumé #}
            <div class="modal" id="edit-summary-modal">
                <div class="modal-content">
                    <span class="close">&times;</span>
                    <h3>Mettre à jour le résumé</h3>

                    <form id="edit-summary-form" action="{{ path('app_livre_edit_summary', {'id': book.id}) }}" method="POST">
                        <p class="summary-warning">
                            Pour plus de précision et éviter les erreurs, nous vous recommandons de reprendre le résumé officiel.
                        </p>
                        <textarea name="summary" rows="6" maxlength="1000" placeholder="Nouveau résumé">{{ book.summary }}</textarea>
                        <p id="char-count">0 / 1000</p>
                        <button type="submit" class="btn-main" style="margin-top:10px;">Valider</button>
                    </form>
                </div>
            </div>

            {# Bouton signaler un pb sur le livre #}
            {% if app.user %}
                <button class="btn-main" data-modal="report-book-modal">Signaler un problème</button>
            {% else %}
                <a href="{{ path('app_login') }}" class="btn-main">Signaler un problème</a>
            {% endif %}

            {# Modal signaler un pb sur le livre #}
            <div class="modal" id="report-book-modal">
                <div class="modal-content">
                    <span class="close">&times;</span>

                    <h3>Signaler un problème sur ce livre</h3>

                    <form id="report-book-form">
                        <input type="hidden" name="book_id" value="{{ book.id }}">

                        <label for="report-book-reason">Motif</label>
                        <select name="reason" id="report-book-reason" required>
                            <option value="">-- Choisir un motif --</option>
                            <option value="titre_incorrect">Titre incorrect</option>
                            <option value="mauvais_auteur">Auteur incorrect</option>
                            <option value="themes_incorrects">Thème(s) incorrect(s)</option>
                            <option value="resume_inexact">Résumé inexact</option>
                            <option value="autre">Autre</option>
                        </select>

                        <label for="report-book-message">Message</label>
                        <textarea
                            name="message"
                            id="report-book-message"
                            maxlength="300"
                            placeholder="Explique brièvement le problème..."
                            required
                        ></textarea>
                        <div class="char-count" id="report-book-char-count">0 / 300</div>

                        <input type="hidden" name="_token" value="{{ csrf_token('report_book') }}">

                        <button type="submit" class="btn-main">Envoyer le signalement</button>
                    </form>
                </div>
            </div>

        </div>
    </div>

    <!-- Note globale et avis -->
    <div class="book-reviews-block">
        <div class="book-rating">
            <h3>Note globale</h3>
            <p>{{ book.averageRating|default('Pas encore noté') }}</p>
        </div>

        <div class="book-reviews">
            <h3>Avis</h3>

            {% for review in reviews %}
                <div class="review-bubble">

                    <!-- COLONNE UTILISATEUR -->
                    <div class="review-user">
                        <a href="{{ path('app_utilisateur_profil', {'id': user.id}) }}" class="user-card">
                            <img
                                src="{{ asset('uploads/profiles/' ~ review.utilisateur.profilePicture) }}"
                                alt="Photo {{ review.utilisateur.pseudo }}"
                            >
                            <span class="review-username">
                                {{ review.utilisateur.pseudo }}
                            </span>
                        </a>
                    </div>

                    <!-- SÉPARATEUR -->
                    <div class="review-separator"></div>

                    <!-- CONTENU AVIS -->
                    <div class="review-content">

                        <!-- HEADER -->
                        <div class="review-header">

                            <div class="review-header-left">
                                <span class="review-date">
                                    {{ review.date|date('d/m/Y') }}
                                </span>

                                {% set shelf = bookshelvesByUser[review.utilisateur.id] ?? null %}
                                <span class="review-category-badge">
                                    {% if shelf and shelf.readingStatus %}
                                        {{ prettyStatuses[shelf.readingStatus.label]
                                            ?? shelf.readingStatus.label|replace({'_': ' '})|capitalize
                                        }}
                                    {% else %}
                                        Non classé
                                    {% endif %}
                                </span>
                            </div>

                            <!-- BOUTON SIGNALER -->
                            {% if review.reports|length > 0 %}
                                <span class="reported-badge" title="Cet avis a déjà été signalé">⚠️ Signalé</span>
                            {% else %}
                                {% if app.user and app.user.id != review.utilisateur.id %}
                                    <button
                                        type="button"
                                        class="review-report-btn"
                                        data-modal="report-modal"
                                        data-review-id="{{ review.id }}"
                                        title="Signaler cet avis"
                                    >
                                        <svg class="report-icon" viewBox="0 0 24 24">
                                            <circle cx="12" cy="12" r="10"/>
                                            <rect x="6" y="11" width="12" height="2"/>
                                        </svg>
                                    </button>
                                {% endif %}
                            {% endif %}

                        </div>

                        <!-- TEXTE -->
                        <div class="review-text">
                            <p>{{ review.comment }}</p>
                        </div>

                    </div>
                </div>

                </div>
            {% else %}
                <p>Aucun avis pour le moment.</p>
            {% endfor %}

            {% if totalPages > 1 %}
                <div class="pagination">
                    {% for i in 1..totalPages %}
                        <a href="?page={{ i }}" class="{{ i == currentPage ? 'active' : '' }}">{{ i }}</a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {# Modal de report avis #}
    <div id="report-modal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>

            <h3>Signaler un avis</h3>

            <form id="report-form">
                <input type="hidden" name="review_id" id="report-review-id">

                <label>Motif</label>
                <select name="reason" id="report-reason" required>
                    <option value="">-- Choisir un motif --</option>
                    <option value="contenu_inapproprie">Contenu inapproprié</option>
                    <option value="spoiler">Orthographe</option>
                    <option value="harcelement">Harcèlement / attaque</option>
                    <option value="autre">Autre</option>
                </select>

                <label>Message</label>
                <textarea
                    name="message"
                    id="report-message"
                    maxlength="300"
                    required
                    placeholder="Explique brièvement le problème..."></textarea>

                <div class="char-count" id="report-char-count">0 / 300</div>

                <input type="hidden" name="_token" value="{{ csrf_token('report_review') }}">

                <button type="submit" class="btn-main">Valider</button>
            </form>
        </div>
    </div>

    {# Modal d'avis #}
    <div id="leave-review-modal" class="modal" style="display:none;" data-book-id="{{ book.id }}">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h3>Laisser un avis</h3>
            <form id="leave-review-form">
                <textarea id="review-text" name="review" rows="6" maxlength="1000" placeholder="Écris ton avis..." required></textarea>
                <div id="char-count-review">0 / 1000</div>
                <button type="submit" class="btn-main">Valider</button>
            </form>
        </div>
    </div>

    {# Modal date de lecture #}
    <div id="reading-date-modal" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>

            <h3>Ajouter une date de lecture</h3>

            <form id="reading-date-form" data-book-id="{{ book.id }}">

                <label class="checkbox-wrapper">
                    <input type="checkbox" id="reading-today">
                    J’ai lu ce livre aujourd’hui
                </label>

                <div class="or-divider">ou</div>

                <label>Date de lecture :</label>
                <input type="date" id="reading-date-picker" max="{{ "now"|date("Y-m-d") }}">

                <button type="submit" class="btn-main">Valider</button>

            </form>
        </div>
    </div>

    {# Modal de note #}
    <div id="rating-modal" class="modal" style="display:none;">
        <div class="modal-content">
            <h2>Laisser une note</h2>

            <div id="rating-stars">
                <span class="star" data-value="1">☆</span>
                <span class="star" data-value="2">☆</span>
                <span class="star" data-value="3">☆</span>
                <span class="star" data-value="4">☆</span>
                <span class="star" data-value="5">☆</span>
            </div>

            <p>Note sélectionnée : <span id="rating-value">0</span> / 5</p>

            <div class="modal-buttons">
                <button id="submit-rating-btn" class="confirm-btn">Valider</button>
                <button id="close-rating-btn" class="cancel-btn">Annuler</button>
            </div>
        </div>
    </div>

    <script>
        const csrfToken = '{{ csrf_token("review_rating") }}';
    </script>
    
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const textarea = document.getElementById('report-message');
            const counter = document.getElementById('report-char-count');

            if (!textarea || !counter) return;

            // Initialiser compteur
            counter.textContent = `${textarea.value.length} / ${textarea.maxLength}`;

            // Mettre à jour au fur et à mesure
            textarea.addEventListener('input', () => {
                counter.textContent = `${textarea.value.length} / ${textarea.maxLength}`;
            });
        });
    </script>

{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/detailsBookModals.js') }}"></script>
 {% endblock %}