<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="description" content="">
        <meta name="keywords" content="livre, partage, club lecture, bibliothèque">
        <meta name="author" content="Storylia">

        <title>{% block title %}Bienvenue{% endblock %}</title>
        
        <!-- Favicon -->
        <link rel="icon" href="{{ asset('images/logo2.PNG') }}" type="image/png">

        <!-- Fichier CSS -->
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">

        <!-- Lien Bootstrap -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

         <!-- Lien Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
       
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="page-container">
            <header class="navbar-custom">
                <div class="container-header">
                    <div class="logo-left">
                        <a href="{{ path('app_accueil') }}"><img src="{{ asset('images/logo.PNG') }}" alt="Storylia" class="logo"></a>
                    </div>

                    <nav class="menu-nav">
                        {% if app.user %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="#">Accueil</a>
                                <span class="separator">|</span>

                                <a href="#">Gérer les employés</a>
                                <span class="separator">|</span>

                                <a href="#">Gérer les utilisateurs</a>
                            {% elseif is_granted('ROLE_EMPLOYE') %}
                                <a href="#">Accueil</a>
                                <span class="separator">|</span>

                                <a href="#">Vérifier les livres</a>
                                <span class="separator">|</span>

                                <a href="#">Signalements</a>
                            {% else %}
                                <a href="{{ path('app_accueil') }}">Accueil</a>
                                <span class="separator">|</span>

                                <a href="#">Club Lecture</a>
                                <span class="separator">|</span>

                                <a href="#">Livres</a>
                                <span class="separator">|</span>

                                <a href="#">Contact</a>
                            {% endif %}

                            <!-- Liens communs à tous les utilisateurs connectés -->
                            <span class="separator">|</span>
                            <a href="#">Mon Compte</a>

                            <span class="separator">|</span>
                            <a href="{{ path('logout') }}">Déconnexion</a>

                            {% else %}
                            <!-- Utilisateur non connecté -->
                            <a href="{{ path('app_accueil') }}">Accueil</a>
                            <span class="separator">|</span>

                            <a href="#">Club Lecture</a>
                            <span class="separator">|</span>

                            <a href="#">Livres</a>
                            <span class="separator">|</span>

                            <a href="#">Contact</a>
                            <span class="separator">|</span>
                            
                            <a href="{{ path('login') }}">Se connecter</a>
                        {% endif %}
                    </nav>
                </div>
            </header>

            <main class="content">
                {% block body %}{% endblock %}
            </main>

            <footer class="nav-footer">
                <div class="container-footer">

                    <div class="navbar-footer">
                        <a href="#">À propos</a>
                        <a href="#">Nous contacter</a>
                        <a href="#">Mentions légales</a>
                    </div>

                    <p class="copyrigth">© Storylia 2025</p>

                    <div class="reseaux-sociaux">
                        <p class="retrouvez-nous">Retrouvez-nous :</p>
                        <a href="#" aria-label="Twitter"><i class="fab fa-x-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="Snapchat"><i class="fab fa-snapchat"></i></a>
                    </div>
                </div>
            </footer>
        </div>
    </body>
</html>
