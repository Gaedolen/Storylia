<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta name="description" content="">
        <meta name="keywords" content="livre, partage, club lecture, bibliothèque">
        <meta name="author" content="Storylia">

        <title>{% block title %}Bienvenue{% endblock %}</title>
        
        <!-- Favicon -->
        <link rel="icon" href="{{ asset('images/logo2.PNG') }}" type="image/png">

        <!-- Fichier CSS -->
        <link rel="stylesheet" href="{{ asset('css/base.css') }}">

        <!-- Bootstrap CSS -->
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

        <!-- Lien Bootstrap icons -->
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css">

         <!-- Lien Font Awesome -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
       
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <div class="page-container">
            <header class="navbar-custom">
                <div class="container-header">
                    <div class="logo-left">
                        <a href="{{ path('app_accueil') }}"><img src="{{ asset('images/logo.PNG') }}" alt="Storylia" class="logo"></a>
                    </div>

                    <div class='menu-section'>
                        <nav class="menu-nav">
                            {% if app.user %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <a href="{{ path('admin_dashboard') }}">Accueil</a>
                                    <span class="separator">|</span>

                                    <a href="#">Gérer les employés</a>
                                    <span class="separator">|</span>

                                    <a href="#">Gérer les utilisateurs</a>
                                {% elseif is_granted('ROLE_EMPLOYE') %}
                                    <a href="#">Accueil</a>
                                    <span class="separator">|</span>

                                    <a href="#">Vérifier les livres</a>
                                    <span class="separator">|</span>

                                    <a href="#">Signalements</a>
                                {% else %}
                                    <a href="{{ path('app_accueil') }}">Accueil</a>
                                    <span class="separator">|</span>

                                    <a href="#">Club Lecture</a>
                                    <span class="separator">|</span>

                                    <a href="{{ path('app_recherche_livre') }}">Livres</a>
                                    <span class="separator">|</span>

                                    <a href="#">Contact</a>
                                {% endif %}

                                <!-- Liens communs à tous les utilisateurs connectés -->
                                <span class="separator">|</span>
                                <a href="{{ path('app_profil') }}">Mon profil</a>

                                <span class="separator">|</span>
                                <a href="{{ path('logout') }}">Déconnexion</a>

                                {% else %}
                                <!-- Utilisateur non connecté -->
                                <a href="{{ path('app_accueil') }}">Accueil</a>
                                <span class="separator">|</span>

                                <a href="#">Club Lecture</a>
                                <span class="separator">|</span>

                                <a href="{{ path('app_recherche_livre') }}">Livres</a>
                                <span class="separator">|</span>

                                <a href="#">Contact</a>
                                <span class="separator">|</span>
                                
                                <a href="{{ path('app_login') }}">Se connecter</a>
                            {% endif %}
                        </nav>

                        {# Formulaire de recherche #}
                        <form class="search-bar" action="{{ path('app_recherche_livre') }}" method="get">
                            <input type="text" name="q" placeholder="Rechercher un livre, un auteur..." required>
                            <button type="submit">
                                <i class="bi bi-search"></i>
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="content">
                {% block body %}{% endblock %}
            </main>

            <footer class="nav-footer">
                <div class="container-footer">

                    <div class="navbar-footer">
                        <a href="#">À propos</a>
                        <a href="#">Nous contacter</a>
                        <a href="#">Mentions légales</a>
                    </div>

                    <p class="copyrigth">© Storylia 2025</p>

                    <div class="reseaux-sociaux">
                        <p class="retrouvez-nous">Retrouvez-nous :</p>
                        <a href="#" aria-label="Twitter"><i class="fab fa-x-twitter"></i></a>
                        <a href="#" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" aria-label="Snapchat"><i class="fab fa-snapchat"></i></a>
                    </div>
                </div>
            </footer>
        </div>

        <!-- Bootstrap JS Bundle (Popper inclus) -->
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
    </body>
</html>
