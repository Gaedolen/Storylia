{% extends 'base.html.twig' %}

{% block title %}Dashboard Admin{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/admin/dashboard.css') }}">
{% endblock %}

{% block body %}
    <div class="admin-dashboard">

        <h1>Tableau de bord administrateur</h1>

        <p class="admin-intro">
            Depuis cette page, vous pouvez gérer les fonctionnalités principales de la plateforme.
        </p>

        <div class="admin-actions">

            {# Import livres #}
            <a href="{{ path('import_books') }}" class="btn-import">
                📚Importer des livres
            </a>

            {# Mise à jour livres #}
            <a href="{{ path('update_books') }}" class="btn-ajout">
                Mettre à jour les livres
            </a>

            {# Gestion des employés #}
            <a href="{{ path('admin_employes') }}" class="btn-employe">
                Gérer les employés
            </a>

            {# Gestion des utilisateur #}
            <a href="#" class="btn-utilisateur">
                Gérer les utilisateurs
            </a>

        </div>

        {# Flash messages #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} mt-3" role="alert">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div id="import-result" style="margin-top: 20px;"></div>

    </div>

    <script src="{{ asset('js/dashboardAdmin.js') }}"></script>
{% endblock %}
