{% extends 'base.html.twig' %}

{% block title %}Bibliothèque de {{ utilisateur.pseudo }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/profil/bibliotheque.css') }}">
{% endblock %}

{% block body %}
    <div class="bibliotheque-container">

        {# --- Menu profil --- #}
        <nav class="profil-menu-horizontal">
            <div class="profil-user">
                <img src="{{ asset('uploads/profiles/' ~ utilisateur.profilePicture) }}" alt="Photo de profil">
                <span class="pseudo">{{ utilisateur.pseudo }}</span>
            </div>

            <ul class="profil-links">
                <li>
                    <a href="{{ isSelf ? path('app_profil') : path('app_utilisateur_profil', {'id': utilisateur.id}) }}" 
                    class="{{ app.request.get('_route') in ['app_profil','app_utilisateur_profil'] ? 'active' : '' }}">
                        Profil
                    </a>
                </li>
                <li>
                    <a href="{{ isSelf ? path('app_profil_bibliotheque') : path('app_utilisateur_bibliotheque', {'id': utilisateur.id}) }}" 
                    class="{{ app.request.get('_route') in ['app_profil_bibliotheque','app_utilisateur_bibliotheque'] ? 'active' : '' }}">
                        Bibliothèque
                    </a>
                </li>
                <li>
                    <a href="{{ isSelf ? path('app_profil_clubs') : path('app_utilisateur_clubs', {'id': utilisateur.id}) }}" 
                    class="{{ app.request.get('_route') in ['app_profil_clubs','app_utilisateur_clubs'] ? 'active' : '' }}">
                        Clubs
                    </a>
                </li>
                <li>
                    <a href="{{ isSelf ? path('app_profil_historique') : path('app_utilisateur_historique', {'id': utilisateur.id}) }}#}" 
                    class="{{ app.request.get('_route') in ['app_profil_historique','app_utilisateur_historique'] ? 'active' : '' }}">
                        Historique
                    </a>
                </li>
            </ul>
        </nav>

        <div class="bibliotheque-categories">
            {% set categoryIcons = {
                'en_train_de_lire' : '<i class="fa-solid fa-book-open"></i>',
                'coup_de_coeur'    : '<i class="fa-solid fa-heart"></i>',
                'adore'            : '<i class="fa-solid fa-star"></i>',
                'apprecie'         : '<i class="fa-regular fa-face-smile"></i>',
                'mitige'           : '<i class="fa-regular fa-face-meh"></i>',
                'pas_aime'         : '<i class="fa-solid fa-heart-crack"></i>',
                'lu_aussi'         : '<i class="fa-solid fa-book-reader"></i>',
                'pal'              : '<i class="fa-solid fa-layer-group"></i>',
                'envies'           : '<i class="fa-regular fa-star"></i>'
            } %}


            {% for status, books in categories %}
                <div class="category" data-status-key="{{ status }}">
                    <h2>
                        {{ status|replace({'_':' '})|capitalize }}
                        {{ categoryIcons[status] | raw }}
                    </h2>

                    <div class="books-container">
                        <div class="category-books">
                            {% for bookshelf in books %}
                                <div class="book-card" data-book-id="{{ bookshelf.book.id }}">
                                    <div class="cover">
                                        <a href="{{ path('app_livre_detail', {'id': bookshelf.book.id}) }}">
                                            <img src="{{ bookshelf.book.cover|replace({'http://':'https://'}) }}" alt="{{ bookshelf.book.title }}">
                                        </a>
                                    </div>
                                    <div class="info">
                                        <div>
                                            <h3>
                                                <a href="{{ path('app_livre_detail', {'id': bookshelf.book.id}) }}">
                                                    {{ bookshelf.book.title }}
                                                </a>
                                            </h3>
                                            <p><a href="#">{{ bookshelf.book.author.name }}</a></p>
                                        </div>
                                        <div class="buttons">
                                            {% if isSelf %}
                                                <button
                                                    class="bookshelf-move-btn"
                                                    data-book-id="{{ bookshelf.book.id }}"
                                                    data-current-status-key="{{ bookshelf.readingStatus ? bookshelf.readingStatus.label : 'envies' }}"
                                                    data-move-url="{{ path('livres_deplacer', {'id': bookshelf.id}) }}">
                                                    <i class="fas fa-arrows-alt"></i>
                                                </button>

                                                <button 
                                                    class="bookshelf-remove-btn"
                                                    data-book-id="{{ bookshelf.id }}">
                                                    <i class="fa-solid fa-trash"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    {# Modal de suppression #}
    <div id="confirm-remove-modal" class="modal">
        <div class="modal-content small-modal">
            <span class="close">&times;</span>
            <p>Voulez-vous retirer ce livre de la bibliothèque ?</p>

            <div class="modal-buttons">
                <button id="confirm-remove-cancel" class="btn-secondary">Non</button>
                <button id="confirm-remove-yes" class="btn-danger">Oui</button>
            </div>
        </div>
    </div>

    {# Modal déplacement #}
    <div id="bookshelf-move-modal" class="modal">
        <div class="modal-content small-modal">
            <span class="close">&times;</span>
            <h3>Déplacer le livre</h3>

            <div class="reading-status-options">
                {% set prettyStatuses = {
                    'en_train_de_lire': 'En train de lire',
                    'coup_de_coeur': 'Coup de coeur',
                    'adore': 'J\'adore',
                    'apprecie': 'Apprécié',
                    'mitige': 'Mitigé',
                    'pas_aime': 'Pas aimé',
                    'lu_aussi': 'Lu',
                    'pal': 'Pile à lire',
                    'envies': 'Mes envies',
                } %}

                {% for status in readingStatuses %}
                    <button class="status-btn" 
                            data-status-id="{{ status.id }}" 
                            data-status-key="{{ status.label }}">
                        {{ prettyStatuses[status.label] ?? status.label }}
                    </button>
                {% endfor %}
            </div>

            <button id="bookshelf-move-confirm" class="btn-primary">Valider</button>
        </div>
    </div>

    {% block javascripts %}
        {{ parent() }}
        <script src="{{ asset('js/BookshelfActions.js') }}"></script>
    {% endblock %}
{% endblock %}
