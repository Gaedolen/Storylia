{% extends 'base.html.twig' %}

{% block title %}Mon historique de lecture{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/profil/historique.css') }}">
{% endblock %}

{% block body %}
    <div class="historique-container">

        {# Menu de navigation profil #}
        <nav class="profil-menu-horizontal">
            <div class="profil-user">
                <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}" alt="Photo de profil">
                <span class="pseudo">{{ app.user.pseudo }}</span>
            </div>

            <ul class="profil-links">
                <li><a href="{{ path('app_profil') }}" class="{{ app.request.get('_route') == 'app_profil' ? 'active' : '' }}">Profil</a></li>
                <li><a href="{{ path('app_profil_bibliotheque') }}" class="{{ app.request.get('_route') == 'app_profil_bibliotheque' ? 'active' : '' }}">Bibliothèque</a></li>
                <li><a href="{{ path('app_profil_clubs') }}" class="{{ app.request.get('_route') == 'app_profil_clubs' ? 'active' : '' }}">Club</a></li>
                <li><a href="{{ path('app_profil_historique') }}" class="{{ app.request.get('_route') == 'app_profil_historique' ? 'active' : '' }}">Historique</a></li>
            </ul>
        </nav>

        {# Contenu principal #}
        <div class="grid-historique">
            {% if historique is not empty %}
                {% for year, months in historique|sort|reverse %}
                    <div class="year-card card">
                        <h3>{{ year }}</h3>
                        {% for month, readings in months %}
                            <div class="month-card">
                                <h4>{{ month }}</h4>
                                <div class="month-books">
                                    {% for reading in readings %}
                                        <div class="book-card">
                                            <div class="cover">
                                                <img src="{{ asset('uploads/books/' ~ reading.book.cover) }}" alt="{{ reading.book.title }}">
                                            </div>
                                            <div class="info">
                                                <div>
                                                    <h5>{{ reading.book.title }}</h5>
                                                    <p>{{ reading.book.author }}</p>
                                                </div>
                                                <div class="buttons">
                                                    <button title="Déplacer">
                                                        <i class="fa-solid fa-arrow-right"></i>
                                                    </button>
                                                    <button title="Supprimer">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endfor %}
            {% else %}
                <p>Vous n'avez encore aucun historique de lecture.</p>
            {% endif %}
        </div>
    </div>
{% endblock %}