{% extends 'base.html.twig' %}

{% block title %}
    {{ isSelf ? 'Mes clubs' : 'Clubs de ' ~ utilisateur.pseudo }}
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/profil/clubs.css') }}">
{% endblock %}

{% block body %}

    <div class="clubs-container">

        {# ===== MENU PROFIL ===== #}
        <nav class="profil-menu-horizontal">
            <div class="profil-user">
                <img
                    src="{{ asset('uploads/profiles/' ~ utilisateur.profilePicture) }}"
                    alt="Photo de profil"
                >
                <span class="pseudo">{{ utilisateur.pseudo }}</span>
            </div>

            <ul class="profil-links">
                <li>
                    <a href="{{ isSelf ? path('app_profil') : path('app_utilisateur_profil', {'id': utilisateur.id}) }}"
                    class="{{ app.request.get('_route') in ['app_profil','app_utilisateur_profil'] ? 'active' : '' }}">
                        Profil
                    </a>
                </li>

                <li>
                    <a href="{{ isSelf ? path('app_profil_bibliotheque') : path('app_utilisateur_bibliotheque', {'id': utilisateur.id}) }}"
                    class="{{ app.request.get('_route') in ['app_profil_bibliotheque','app_utilisateur_bibliotheque'] ? 'active' : '' }}">
                        Bibliothèque
                    </a>
                </li>

                <li>
                    <a href="{{ isSelf ? path('app_profil_clubs') : path('app_utilisateur_clubs', {'id': utilisateur.id}) }}"
                    class="{{ app.request.get('_route') in ['app_profil_clubs','app_utilisateur_clubs'] ? 'active' : '' }}">
                        Clubs
                    </a>
                </li>

                <li>
                    <a href="{{ isSelf ? path('app_profil_historique') : path('app_utilisateur_historique', {'id': utilisateur.id}) }}#}"
                    class="{{ app.request.get('_route') in ['app_profil_historique','app_utilisateur_historique'] ? 'active' : '' }}">
                        Historique
                    </a>
                </li>
            </ul>
        </nav>

    </div>

    <div class="listing-container">

    {% set preferencesLabels = {
        'scifi': 'Science-Fiction',
        'fantastique': 'Fantastique',
        'fantasy': 'Fantasy',
        'dystopie': 'Dystopie',
        'steampunk': 'Steampunk',
        'policier': 'Policier',
        'thriller': 'Thriller',
        'espionnage': 'Espionnage',
        'horreur': 'Horreur',
        'aventure': 'Aventure',
        'young_adult': 'Young Adult',
        'romance': 'Romance',
        'erotique': 'Érotique',
        'chicklit': 'Chick-lit',
        'essai': 'Essai',
        'biographie': 'Biographie',
        'philosophie': 'Philosophie',
        'historique': 'Historique',
        'science': 'Science',
        'sociologie': 'Sociologie',
        'poesie': 'Poésie',
        'theatre': 'Théâtre',
        'conte_legend': 'Contes et légendes',
        'mythologie': 'Mythologie',
        'graphic_novel': 'Roman Graphique',
        'bd': 'Bande dessinée',
        'manga': 'Manga'
    } %}

        {# ===== CLUBS CRÉÉS ===== #}
        <section class="clubs-list">
            {% for club in clubsCrees %}
                {% set isInactive = club.status != 'actif' %}
                <a 
                    {% if not isInactive %}href="{{ path('club_show', {'id': club.id}) }}"{% endif %} 
                    class="club-card {% if isInactive %}club-inactif{% endif %}"
                >

                    <div class="club-card-left">
                        {% if club.photo %}
                            <img src="{{ asset('uploads/clubs/' ~ club.photo) }}" alt="{{ club.name }}">
                        {% else %}
                            <div class="club-photo-placeholder">Aucune photo</div>
                        {% endif %}

                        <div class="club-card-meta">
                            <span class="club-participants">
                                {{ club.membres|length }} participants
                            </span>
                            <span class="creation-date">
                                Créé le {{ club.creationDate|date('d/m/Y') }}
                            </span>
                        </div>
                    </div>

                    <div class="club-card-right">
                        <h3>{{ club.name }}</h3>

                        <div class="club-description">
                            {{ club.description }}
                        </div>

                        <div class="club-preferences">
                            {% for code in club.preferences %}
                                <span class="pref-badge">
                                    {{ preferencesLabels[code] }}
                                </span>
                            {% endfor %}
                        </div>

                    </div>

                    {% if isInactive %}
                        <span class="inactive-label">Inactif</span>
                    {% endif %}

                </a>
            {% else %}
                <p class="empty">
                    {{ isSelf ? 'Vous n’avez créé aucun club.' : 'Aucun club créé.' }}
                </p>
            {% endfor %}
        </section>

        {# ===== CLUBS MEMBRE ===== #}
        <h2>
            {{ isSelf ? 'Clubs dont je suis membre' : 'Clubs dont ' ~ utilisateur.pseudo ~ ' est membre' }}
        </h2>

        <section class="clubs-list">
        {% for club in clubsMembre %}
            {% set isInactive = club.status != 'actif' %}
            <a 
                {% if not isInactive %}href="{{ path('club_show', {'id': club.id}) }}"{% endif %} 
                class="club-card {% if isInactive %}club-inactif{% endif %}"
            >

                <div class="club-card-left">
                    {% if club.photo %}
                        <img src="{{ asset('uploads/clubs/' ~ club.photo) }}" alt="{{ club.name }}">
                    {% else %}
                        <div class="club-photo-placeholder">Aucune photo</div>
                    {% endif %}

                    <div class="club-card-meta">
                        <span class="club-participants">
                            {{ club.membres|length }} participants
                        </span>
                        <span class="creation-date">
                            Créé le {{ club.creationDate|date('d/m/Y') }}
                        </span>
                    </div>
                </div>

                <div class="club-card-right">
                    <h3>{{ club.name }}</h3>

                    <div class="club-description">
                        {{ club.description }}
                    </div>

                    <div class="club-preferences">
                        {% for code in club.preferences %}
                            <span class="pref-badge">
                                {{ preferencesLabels[code] }}
                            </span>
                        {% endfor %}
                    </div>

                </div>

                {% if isInactive %}
                    <span class="inactive-label">Inactif</span>
                {% endif %}

            </a>
        {% else %}
            <p class="empty">
                {{ isSelf ? 'Vous n’êtes membre d’aucun club.' : 'Aucun club rejoint.' }}
            </p>
        {% endfor %}
    </section>

    </div>

{% endblock %}
