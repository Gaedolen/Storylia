{% extends 'base.html.twig' %}

{% block title %}Profil de {{ utilisateur.pseudo }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('css/profil/profil.css') }}">
{% endblock %}

{% block body %}
<div class="profil-container">

    {# Menu de navigation profil #}
    <nav class="profil-menu-horizontal">
        <div class="profil-user">
            {% set profileImage = utilisateur.profilePicture ?: 'default.png' %}

            <img 
                src="{{ asset('uploads/profiles/' ~ profileImage|e('html_attr')) }}" 
                alt="Photo de profil"
            >
            <span class="pseudo">{{ utilisateur.pseudo|e }}</span>
        </div>

        <ul class="profil-links">
            <li>
                <a href="{{ isSelf ? path('app_profil') : path('app_utilisateur_profil', {'id': utilisateur.id}) }}" 
                class="{{ app.request.get('_route') in ['app_profil','app_utilisateur_profil'] ? 'active' : '' }}">
                    Profil
                </a>
            </li>
            <li>
                <a href="{{ isSelf ? path('app_profil_bibliotheque') : path('app_utilisateur_bibliotheque', {'id': utilisateur.id}) }}" 
                class="{{ app.request.get('_route') in ['app_profil_bibliotheque','app_utilisateur_bibliotheque'] ? 'active' : '' }}">
                    Bibliothèque
                </a>
            </li>
            <li>
                <a href="{{ isSelf ? path('app_profil_clubs') : path('app_utilisateur_clubs', {'id': utilisateur.id}) }}" 
                class="{{ app.request.get('_route') in ['app_profil_clubs','app_utilisateur_clubs'] ? 'active' : '' }}">
                    Clubs
                </a>
            </li>
            <li>
                <a href="{{ isSelf ? path('app_profil_historique') : path('app_utilisateur_historique', {'id': utilisateur.id}) }} }}" 
                class="{{ app.request.get('_route') in ['app_profil_historique','app_utilisateur_historique'] ? 'active' : '' }}">
                    Historique
                </a>
            </li>
        </ul>
    </nav>

    <!-- CONTENU PRINCIPAL -->
    <main class="profil-main">
        <div class="grid-profil">

            <!-- Carte données personnelles -->
            <div class="card personal-info">
                <div class="personal-info-header">
                    <h3>Profil de {{ utilisateur.pseudo|e }}</h3>

                    {% if currentUser and not isSelf %}
                        {% if hasReported %}
                            <span class="report-badge in-progress">Signalé</span>
                        {% else %}
                            <button
                                type="button"
                                class="btn btn-warning btn-report-user"
                                data-url="{{ path('report_user', {'id': utilisateur.id}) }}"
                            >
                                Signaler
                            </button>
                        {% endif %}
                    {% endif %}

                </div>

                {# Modal de report utilisateur #}
                <div id="report-user-modal" class="modal">
                    <div class="modal-content">
                        <span id="close-report-user" class="close">&times;</span>
                        <form id="report-user-form">
                        <input type="hidden" id="report-user-id" name="user_id" value="">
                        
                        <label>Motif</label>
                        <select name="reason" id="report-user-reason" required>
                            <option value="">-- Choisir un motif --</option>
                            <option value="harcelement">Harcèlement / comportement toxique</option>
                            <option value="usurpation">Usurpation d'identité</option>
                            <option value="spam">Spam</option>
                            <option value="contenu_inapproprie">Contenu inapproprié</option>
                            <option value="autre">Autre</option>
                        </select>

                        <label>Message</label>
                        <textarea id="report-user-message" name="message" maxlength="500" required></textarea>
                        <div id="report-user-char-count">0 / 500</div>

                        <input type="hidden" name="_token" value="{{ csrf_token('report_user') }}">
                        <button type="submit" class="btn btn-warning">Signaler</button>
                        </form>
                    </div>
                </div>


                <div class="info-grid">
                    <div class="info-item">
                        <i class="fa-solid fa-user"></i>
                        <span class="label">Pseudo</span>
                        <span class="value">{{ utilisateur.pseudo|e }}</span>
                    </div>

                    <div class="info-item">
                        <i class="fa-solid fa-calendar"></i>
                        <span class="label">Année de naissance</span>
                        <span class="value">{{ utilisateur.birthDate|date('Y') }}</span>
                    </div>

                    <a href="{{ path('app_profil_bibliotheque') }}" class="info-item link-card">
                        <i class="fa-solid fa-book"></i>
                        <span class="label">Livres dans la bibliothèque</span>
                        <span class="value">
                            {{ utilisateur.bookshelves|filter(b => b.readingStatus != 'envies')|length }}
                        </span>
                    </a>

                    <div class="info-item bio-box">
                        <div class="bio-header">
                            <i class="fa-solid fa-pen"></i>
                            <span class="label">À propos de moi</span>
                        </div>

                        <div class="bio-content">
                            {% if utilisateur.bio %}
                                <p class="bio-text">{{ utilisateur.bio|e }}</p>
                            {% else %}
                                <p class="bio-text empty">Aucune description pour le moment.</p>
                            {% endif %}
                        </div>
                    </div>
                </div>

                {% if utilisateur.presentation %}
                    <div class="presentation">
                        <h4>À propos de moi</h4>
                        <p>{{ utilisateur.presentation|e }}</p>
                    </div>
                {% endif %}
            </div>

            <!-- Carte préférences et coups de coeur -->
            <div class="card preferences">
                <div class="space-between">
                    <h3>Préférences de lecture</h3>
                    <div class="preferences-badges">
                        {% for pref in utilisateur.preferences %}
                            <span class="preference-badge">{{ preferenceLabels[pref]|default(pref) }}</span>
                        {% endfor %}
                    </div>
                </div>

                <div class="space-between">    
                    <h3>Mes coups de coeur</h3>
                    <div id="coupsDeCoeurCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                        <div class="carousel-wrapper">
                            <div class="carousel-inner">
                                {% for chunk in coupsDeCoeur|batch(4) %}
                                    <div class="carousel-item {% if loop.first %}active{% endif %}">
                                        <div class="carousel-books-row">
                                            <div class="d-flex justify-content-center gap-3">
                                                {% for livre in chunk %}
                                                    <a href="{{ path('app_livre_detail', {id: livre.book.id}) }}" class="carousel-card-link">
                                                        <div class="card carousel-card">
                                                            <img src="{{ livre.book.cover|replace({'http://':'https://'})|e('html_attr') }}" class="card-img-top" alt="{{ livre.book.title }}">
                                                            <div class="card-body text-center">
                                                                <h6 class="card-title">{{ livre.book.title }}</h6>
                                                                <p class="card-text">{{ livre.book.author.name }}</p>
                                                            </div>
                                                        </div>
                                                    </a>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>

                        <!-- Flèches carousel -->
                        <button class="carousel-control-prev" type="button" data-bs-target="#coupsDeCoeurCarousel" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Précédent</span>
                        </button>
                        <button class="carousel-control-next" type="button" data-bs-target="#coupsDeCoeurCarousel" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Suivant</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="reading-row">
            <!-- Lecture du moment -->
            <div class="card current-reading">
                <h3>Lecture du moment</h3>

                {% if lectureEnCours %}
                    <div class="lecture-container">
                        <div class="lecture-cover">
                            <a href="{{ path('app_livre_detail', {id: lectureEnCours.book.id}) }}">
                                <img src="{{ lectureEnCours.book.cover|replace({'http://':'https://'})|default(asset('images/default_cover.jpg'))|e('html_attr') }}" 
                                    alt="{{ lectureEnCours.book.title }}">
                            </a>
                        </div>

                        <div class="lecture-info">
                            <h4>
                                <a href="{{ path('app_livre_detail', {id: lectureEnCours.book.id}) }}">
                                    {{ lectureEnCours.book.title }}
                                </a>
                            </h4>
                            <p>
                                <a href="#">{{ lectureEnCours.book.author.name|default('Auteur inconnu') }}</a>
                            </p>
                        </div>

                        {% if isSelf %}
                            <div class="lecture-progress">
                                {% set totalPages = lectureEnCours.book.pages ?? 0 %}
                                {% set pagesRead = lectureEnCours.pagesRead ?? 0 %}
                                {% set percent = totalPages > 0 ? (pagesRead / totalPages * 100) : 0 %}

                                <div class="reading-progress-wrapper">
                                    <div id="progressContainer" class="circle-wrapper">
                                        <svg class="progress-ring" width="160" height="160">
                                            <circle class="progress-ring-bg" cx="80" cy="80" r="70" stroke="#ddd" stroke-width="12" fill="transparent"/>
                                            <circle id="progressCircle" class="progress-ring-progress" cx="80" cy="80" r="70" stroke="#C97C5D" stroke-width="12" fill="transparent"
                                                data-total-pages="{{ totalPages }}" data-progress="{{ percent }}" stroke-dasharray="439.82" stroke-dashoffset="{{ 439.82 - (439.82 * percent / 100) }}"/>
                                        </svg>

                                        <div class="progress-center">
                                            {% if totalPages == 0 %}
                                                <input id="pagesReadInput" type="number" min="0" value="{{ pagesRead }}" class="progress-input">
                                                <input id="totalPagesInput" type="number" min="1" placeholder="Total" class="progress-input">
                                            {% else %}
                                                <input id="pagesReadInput" type="number" min="0" value="{{ pagesRead }}" class="progress-input">
                                                <span class="total-pages-text">sur {{ totalPages }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    
                                    {# ===== Barre de progression responsive ===== #}
                                    <div class="progress-bar-mobile">
                                        <div class="progress-bar-inputs">
                                            {% if totalPages == 0 %}
                                                <input id="pagesReadInputMobile" type="number" min="0" value="{{ pagesRead }}" class="progress-input-mobile" placeholder="Pages lues">
                                                <input id="totalPagesInputMobile" type="number" min="1" value="{{ totalPages }}" class="progress-input-mobile" placeholder="Total">
                                            {% else %}
                                                <input id="pagesReadInputMobile" type="number" min="0" value="{{ pagesRead }}" class="progress-input-mobile">
                                                <span class="total-pages-text-mobile">sur {{ totalPages }}</span>
                                            {% endif %}
                                        </div>

                                        <div class="progress-bar-track">
                                            <!-- Partie animée = reste à lire -->
                                            <div class="progress-bar-remaining"></div>
                                            <!-- Partie lue -->
                                            <div class="progress-bar-fill"
                                                style="width: {{ percent|number_format(0) }}%;"></div>
                                        </div>

                                        <div class="progress-bar-info">
                                            <span class="progress-percent-mobile">{{ percent|number_format(0) }}%</span>
                                            <button type="button" class="progress-btn-mobile">Mettre à jour</button>
                                        </div>
                                    </div>

                                    <div id="percentageDisplay" class="progress-percent">
                                        {{ percent|number_format(0) }}%
                                    </div>

                                    <button id="updateProgressBtn" type="button" class="progress-btn">
                                        Mettre à jour
                                    </button>

                                    <form id="updateProgressForm"
                                        action="{{ path('app_update_pages_read', {id: lectureEnCours.id}) }}"
                                        method="POST"
                                        style="display:none;">

                                        <input type="hidden" name="pagesRead" id="pagesReadField">
                                        <input type="hidden" name="totalPages" id="totalPagesField">
                                        <input type="hidden" name="_token"
                                            value="{{ csrf_token('update_pages_read' ~ lectureEnCours.id) }}">
                                    </form>

                                </div>
                            </div>
                        {% endif %}
                    </div>
                {% else %}
                    <div>Aucune lecture en cours</div>
                {% endif %}
            </div>

            <!-- Carrousel dernières lectures -->
            <div class="card last-read">
                <h3>Dernières lectures</h3>

                <!-- Flèches en dehors du carousel-wrapper mais dans la carte -->
                <button class="carousel-control-prev" type="button" data-bs-target="#lastReadCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>

                <div class="carousel-wrapper">
                    <div id="lastReadCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="3000">
                        <div class="carousel-inner">
                            {% for book in lastRead|batch(4) %}
                                <div class="carousel-item {% if loop.first %}active{% endif %}">
                                    <div class="carousel-books-row">
                                        <div class="d-flex justify-content-center gap-3">
                                            {% for shelf in book %}
                                                <a href="{{ path('app_livre_detail', {id: shelf.book.id}) }}" class="carousel-card-link text-center">
                                                    <div class="card carousel-card">
                                                        <img src="{{ shelf.book.cover|replace({'http://':'https://'})|e('html_attr') }}" class="card-img-top" alt="{{ shelf.book.title }}">
                                                        <div class="card-body">
                                                            <h6 class="card-title">{{ shelf.book.title|e }}</h6>
                                                            <p class="card-text">{{ shelf.readingDate|date('d/m/Y') }}</p>
                                                        </div>
                                                    </div>
                                                </a>
                                            {% endfor %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <button class="carousel-control-next" type="button" data-bs-target="#lastReadCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>

        </div>

    </main>

</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script src="{{ asset('js/profil.js') }}"></script>
{% endblock %}
