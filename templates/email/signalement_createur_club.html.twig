<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Signalement concernant votre club</title>
</head>
    <body style="
        margin:0;
        padding:0;
        background-color:#FAF3E0;
        font-family: Arial, sans-serif;
        color:#3B2F2F;
    ">

    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#FAF3E0; padding:30px 0;">
        <tr>
            <td align="center">

                <table width="600" cellpadding="0" cellspacing="0" style="
                    background-color:#E8CBAE;
                    border-radius:8px;
                    overflow:hidden;
                ">

                    <!-- En-tête -->
                    <tr>
                        <td style="
                            background-color:#5F7F5F;
                            color:#FAF3E0;
                            padding:20px;
                            text-align:center;
                        ">
                            <h1 style="
                                margin:0;
                                font-size:22px;
                                color:#FAF3E0;
                            ">
                                Signalement concernant votre club
                            </h1>
                        </td>
                    </tr>

                    <!-- Corps -->
                    <tr>
                        <td style="
                            padding:30px;
                            font-size:14px;
                            line-height:1.6;
                            color:#3B2F2F;
                        ">

                            <p style="margin-top:0;">
                                Bonjour <strong>{{ user.pseudo }}</strong>,
                            </p>

                            <p>
                                Votre club
                                <strong style="color:#714B2F;">
                                    {{ club.name }}
                                </strong>
                                a fait l’objet d’un signalement par un utilisateur.
                            </p>

                            <!-- Bloc motif -->
                            <table width="100%" cellpadding="0" cellspacing="0" style="margin:20px 0; border-collapse:collapse;">
                                <tr>
                                    <td style="
                                        padding:8px;
                                        background-color:#FAF3E0;
                                        width:120px;
                                        color:#3B2F2F;
                                    ">
                                        <strong>Motif</strong>
                                    </td>
                                    <td style="
                                        padding:8px;
                                        border:1px solid #C97C5D;
                                        background-color:#FAF3E0;
                                    ">
                                        {{ reason }}
                                    </td>
                                </tr>
                            </table>

                            <p style="margin-bottom:5px;">
                                <strong>Message de l’équipe de modération :</strong>
                            </p>

                            <!-- Bloc message -->
                            <div style="
                                background-color:#FAF3E0;
                                border:1px solid #C97C5D;
                                padding:15px;
                                border-radius:5px;
                                white-space:pre-line;
                                color:#3B2F2F;
                            ">
                                {{ message }}
                            </div>

                            <p style="margin-top:25px;">
                                Merci de prendre les mesures nécessaires afin de garantir un bon fonctionnement de votre club.
                            </p>

                            <p style="margin-bottom:0; color:#6B6B6B;">
                                Cordialement,<br>
                                <strong style="color:#714B2F;">
                                    L’équipe de modération Storylia
                                </strong>
                            </p>

                        </td>
                    </tr>

                    <!-- Pied de page -->
                    <tr>
                        <td style="
                            background-color:#5F7F5F;
                            color:#FAF3E0;
                            font-size:12px;
                            text-align:center;
                            padding:15px;
                        ">
                            Cet email vous a été envoyé automatiquement. Merci de ne pas y répondre.
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>

    </body>
</html>
